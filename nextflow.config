params {
    samplesheet = null                       // TSV: sample_id, bam, [bai], lofreq_vcf
    pairs       = null                       // TSV: pair_id, donor_sample_id, recipient_sample_id, [extra columns]
    reference   = null                       // H37Rv FASTA used for mapping (needs .fai next to it)
    mask_bed    = "${projectDir}/assets/H37Rv_ppe.bed.gz"   // PE/PPE mask from mtb-call2
    outdir      = "results"

    // bcftools mpileup read filters for allele counting
    min_mapq    = 20
    min_baseq   = 20
    max_depth   = 100000
}

process {
    cpus   = 1
    memory = '4 GB'
    time   = '2h'
    withLabel: bcftools { container = 'ksw9/mtb-call:variantcalling' }   // same image mtb-call2 uses
    withLabel: rscript  { container = 'rocker/r-ver:4.4.1' }
}

profiles {
    // run with tools already on PATH (bcftools, Rscript)
    local {
        process.executor = 'local'
    }
    // CHPC: SLURM + Apptainer (account/partition as in mtb-call2)
    chpc {
        process.executor       = 'slurm'
        process.clusterOptions = '-A walter --partition kingspeak-shared'
        apptainer.enabled      = true
        apptainer.autoMounts   = true
    }
    docker {
        docker.enabled = true
    }
    test {
        params.samplesheet = "${projectDir}/tests/data/samplesheet.tsv"
        params.pairs       = "${projectDir}/tests/data/pairs.tsv"
        params.reference   = "${projectDir}/tests/data/ref.fa"
        params.mask_bed    = "${projectDir}/tests/data/mask.bed.gz"
        params.outdir      = "${projectDir}/tests/results"
        process.executor   = 'local'
    }
}

manifest {
    name        = 'bottleneck_prep'
    description = 'Per-pair allele counts from mtb-call2 output for beta-binomial transmission bottleneck estimation'
    mainScript  = 'main.nf'
}
